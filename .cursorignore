# .cursorignore — gerado pelo SDDS
# Exclui da indexação do Cursor arquivos que não devem ser pesquisados ou indexados.
# Edite conforme as necessidades do projeto (este arquivo pode ser customizado).

# Runtime privado SDDS — não indexar (volumoso e interno ao framework)
_sdds_private/

# Sessões arquivadas — muitos arquivos pequenos, raramente úteis para indexação
.sdds/sessions/archive/
.sdds/timeline/archive/

# Dependências e artefatos de build
node_modules/
dist/
build/
.next/
out/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
coverage/
.coverage
htmlcov/

# Artefatos de ambiente
.env
.env.*
*.log
*.tmp
*.cache

# Binários e mídia pesada
*.zip
*.tar.gz
*.rar
*.7z
*.iso
*.exe
*.dll
*.so
*.dylib
*.pdf
*.mp4
*.mp3
*.mov
*.avi
