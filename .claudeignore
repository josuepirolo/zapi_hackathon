# .claudeignore — gerado pelo SDDS
# Exclui da busca automática do Claude Code arquivos que não devem ser descobertos.
# Claude ainda pode ler qualquer arquivo diretamente pelo caminho (Read tool).
# Edite conforme as necessidades do projeto.

# Runtime privado SDDS — lido apenas quando o agente usa o caminho explícito
_sdds_private/

# Sessões arquivadas — histórico antigo, não relevante para contexto atual
.sdds/sessions/archive/
.sdds/timeline/archive/

# Dependências e artefatos de build
node_modules/
dist/
build/
.next/
out/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
coverage/
.coverage
htmlcov/

# Artefatos de ambiente e logs
.env
.env.*
*.log
*.tmp
*.cache

# Binários e mídia
*.zip
*.tar.gz
*.rar
*.7z
*.iso
*.exe
*.dll
*.so
*.dylib
*.pdf
*.mp4
*.mp3
*.mov
*.avi
